<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_kpi" model="res.groups.privilege">
        <field name="name">KPI</field>
        <field name="description">Key Performance Indicators and scorecards</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_kpi_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_kpi"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees the KPIs and scorecards assigned to them and records manual results for the KPIs they are responsible for.</field>
    </record>

    <record id="group_kpi_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_kpi"/>
        <field name="implied_ids" eval="[(4, ref('group_kpi_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configures KPIs, enters all results and manages every scorecard.</field>
    </record>
</odoo>
