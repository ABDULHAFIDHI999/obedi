<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kpi_scorecard_view_list" model="ir.ui.view">
        <field name="name">kpi.scorecard.list</field>
        <field name="model">kpi.scorecard</field>
        <field name="arch" type="xml">
            <list string="Scorecards" sample="1"
                  decoration-muted="state == 'cancel'"
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="reviewer_id" widget="many2one_avatar_user" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="score" widget="progressbar"/>
                <field name="rating" widget="badge"
                       decoration-success="rating == 'excellent'"
                       decoration-info="rating == 'good'"
                       decoration-warning="rating == 'fair'"
                       decoration-danger="rating == 'poor'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="kpi_scorecard_view_kanban" model="ir.ui.view">
        <field name="name">kpi.scorecard.kanban</field>
        <field name="model">kpi.scorecard</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="rating"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <div class="text-muted small">
                            <field name="date_from"/> → <field name="date_to"/>
                        </div>
                        <field name="score" widget="progressbar"/>
                        <footer>
                            <field name="rating" widget="badge"
                                   decoration-success="rating == 'excellent'"
                                   decoration-info="rating == 'good'"
                                   decoration-warning="rating == 'fair'"
                                   decoration-danger="rating == 'poor'"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="kpi_scorecard_view_form" model="ir.ui.view">
        <field name="name">kpi.scorecard.form</field>
        <field name="model">kpi.scorecard</field>
        <field name="arch" type="xml">
            <form string="Scorecard">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary"
                            invisible="state != 'draft'" groups="kpi_management.group_kpi_manager"/>
                    <button name="action_refresh" type="object" string="Refresh Results"
                            invisible="state not in ('draft', 'in_progress')" groups="kpi_management.group_kpi_manager"/>
                    <button name="action_done" type="object" string="Mark as Done" class="btn-primary"
                            invisible="state != 'in_progress'" groups="kpi_management.group_kpi_manager"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('in_progress', 'cancel')" groups="kpi_management.group_kpi_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancel')" groups="kpi_management.group_kpi_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Q4 2026 - Sales Team Lead" readonly="state == 'done'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user" readonly="state == 'done'"/>
                            <field name="reviewer_id" widget="many2one_avatar_user" readonly="state == 'done'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <label for="date_from" string="Period"/>
                            <div class="o_row">
                                <field name="date_from" readonly="state == 'done'"/>
                                <span>→</span>
                                <field name="date_to" readonly="state == 'done'"/>
                            </div>
                            <field name="max_achievement" readonly="state == 'done'"/>
                        </group>
                    </group>
                    <group class="mt-2">
                        <group>
                            <field name="score" widget="progressbar"/>
                            <field name="rating" widget="badge"
                                   decoration-success="rating == 'excellent'"
                                   decoration-info="rating == 'good'"
                                   decoration-warning="rating == 'fair'"
                                   decoration-danger="rating == 'poor'"/>
                        </group>
                        <group>
                            <field name="total_weight" decoration-danger="total_weight != 100"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="KPIs" name="lines">
                            <field name="line_ids" readonly="state == 'done'">
                                <list editable="bottom"
                                      decoration-success="status == 'on_track'"
                                      decoration-warning="status == 'at_risk'"
                                      decoration-danger="status == 'off_track'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="kpi_id" options="{'no_create': True}"/>
                                    <field name="weight" sum="Total"/>
                                    <field name="target_value"/>
                                    <field name="actual_value"/>
                                    <field name="unit_label" string="Unit" optional="show"/>
                                    <field name="achievement" widget="progressbar"/>
                                    <field name="weighted_score" sum="Total" optional="show"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'on_track'"
                                           decoration-warning="status == 'at_risk'"
                                           decoration-danger="status == 'off_track'"/>
                                    <field name="comment" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comments" name="comments">
                            <field name="note" placeholder="Overall assessment, strengths, improvement areas..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="kpi_scorecard_view_search" model="ir.ui.view">
        <field name="name">kpi.scorecard.search</field>
        <field name="model">kpi.scorecard</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="reviewer_id"/>
                <filter string="My Scorecards" name="my_scorecards" domain="[('user_id', '=', uid)]"/>
                <filter string="To Review" name="to_review" domain="[('reviewer_id', '=', uid), ('state', '=', 'in_progress')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Period" name="filter_date_from" date="date_from"/>
                <group>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Rating" name="group_rating" context="{'group_by': 'rating'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kpi_scorecard" model="ir.actions.act_window">
        <field name="name">Scorecards</field>
        <field name="res_model">kpi.scorecard</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a scorecard</p>
            <p>Select KPIs, give each one a weight (total 100) and get a weighted performance score for a period.</p>
        </field>
    </record>
</odoo>
