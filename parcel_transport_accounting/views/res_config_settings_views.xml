<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_parcel_accounting" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.parcel.transport.accounting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="parcel_transport.res_config_settings_view_form_parcel"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='parcel_delivery_setting']" position="after">
                <block title="Accounting" id="parcel_accounting_setting">
                    <setting string="Auto-post Parcel Revenue"
                             help="Every time a parcel payment is authorized, a journal entry is posted automatically: Debit the receipt account matching its payment method, Credit the Revenue account. Refunding/cancelling a payment reverses it automatically. Cash/Mobile Money/Bank balances update immediately - no bank-statement reconciliation needed.">
                        <field name="parcel_revenue_journal_id"/>
                        <field name="parcel_revenue_account_id"/>
                        <field name="parcel_receipt_account_cash_id"/>
                        <field name="parcel_receipt_account_mobile_id"/>
                        <field name="parcel_receipt_account_bank_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
