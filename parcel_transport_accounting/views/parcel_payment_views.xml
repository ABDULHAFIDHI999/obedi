<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_parcel_payment_form_inherit_accounting" model="ir.ui.view">
        <field name="name">parcel.payment.form.inherit.accounting</field>
        <field name="model">parcel.payment</field>
        <field name="inherit_id" ref="parcel_transport.view_parcel_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="accounting_button_box">
                    <button class="oe_stat_button" icon="fa-book" type="object"
                            name="action_view_journal_entry" invisible="not account_move_id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Journal Entry</span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
