<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kpi_value_view_list" model="ir.ui.view">
        <field name="name">kpi.value.list</field>
        <field name="model">kpi.value</field>
        <field name="arch" type="xml">
            <list string="KPI Results" sample="1"
                  decoration-success="status == 'on_track'"
                  decoration-warning="status == 'at_risk'"
                  decoration-danger="status == 'off_track'">
                <field name="kpi_id"/>
                <field name="category_id" optional="show"/>
                <field name="period_label"/>
                <field name="date_from" optional="hide"/>
                <field name="date_to" optional="hide"/>
                <field name="actual_value"/>
                <field name="target_value"/>
                <field name="variance" optional="hide"/>
                <field name="unit_label" string="Unit" optional="show"/>
                <field name="achievement" widget="progressbar"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'on_track'"
                       decoration-warning="status == 'at_risk'"
                       decoration-danger="status == 'off_track'"/>
                <field name="source" optional="show"/>
                <field name="responsible_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="kpi_value_view_form" model="ir.ui.view">
        <field name="name">kpi.value.form</field>
        <field name="model">kpi.value</field>
        <field name="arch" type="xml">
            <form string="KPI Result">
                <header>
                    <button name="action_recompute" type="object" string="Recompute" class="btn-secondary"
                            groups="kpi_management.group_kpi_manager"
                            invisible="not id"/>
                    <field name="status" widget="statusbar" invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" placeholder="New result"/></h1>
                    </div>
                    <group>
                        <group string="Period">
                            <field name="kpi_id" options="{'no_create': True}"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="frequency"/>
                            <field name="source"/>
                        </group>
                        <group string="Result">
                            <label for="actual_value"/>
                            <div class="o_row">
                                <field name="actual_value"/>
                                <field name="unit_label" nolabel="1"/>
                            </div>
                            <field name="target_value"/>
                            <field name="variance"/>
                            <field name="achievement" widget="progressbar"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Comments, root cause, action plan..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kpi_value_view_search" model="ir.ui.view">
        <field name="name">kpi.value.search</field>
        <field name="model">kpi.value</field>
        <field name="arch" type="xml">
            <search>
                <field name="kpi_id"/>
                <field name="category_id"/>
                <field name="responsible_id"/>
                <filter string="My KPIs" name="my_kpis" domain="[('responsible_id', '=', uid)]"/>
                <separator/>
                <filter string="On Track" name="on_track" domain="[('status', '=', 'on_track')]"/>
                <filter string="At Risk" name="at_risk" domain="[('status', '=', 'at_risk')]"/>
                <filter string="Off Track" name="off_track" domain="[('status', '=', 'off_track')]"/>
                <separator/>
                <filter string="Period" name="filter_date_from" date="date_from"/>
                <group>
                    <filter string="KPI" name="group_kpi" context="{'group_by': 'kpi_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Responsible" name="group_responsible" context="{'group_by': 'responsible_id'}"/>
                    <filter string="Period" name="group_period" context="{'group_by': 'date_from:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kpi_value_view_graph" model="ir.ui.view">
        <field name="name">kpi.value.graph</field>
        <field name="model">kpi.value</field>
        <field name="arch" type="xml">
            <graph string="KPI Trend" type="line" sample="1">
                <field name="date_from" interval="month"/>
                <field name="kpi_id"/>
                <field name="actual_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="kpi_value_view_pivot" model="ir.ui.view">
        <field name="name">kpi.value.pivot</field>
        <field name="model">kpi.value</field>
        <field name="arch" type="xml">
            <pivot string="KPI Analysis" sample="1">
                <field name="kpi_id" type="row"/>
                <field name="date_from" interval="month" type="col"/>
                <field name="actual_value" type="measure"/>
                <field name="target_value" type="measure"/>
                <field name="achievement" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_kpi_value" model="ir.actions.act_window">
        <field name="name">KPI Results</field>
        <field name="res_model">kpi.value</field>
        <field name="view_mode">list,graph,pivot,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first KPI result</p>
            <p>Results are computed automatically by the scheduler for automatic KPIs, or entered manually.</p>
        </field>
    </record>

    <record id="action_kpi_value_analysis" model="ir.actions.act_window">
        <field name="name">KPI Analysis</field>
        <field name="res_model">kpi.value</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_filter_date_from': 1}</field>
    </record>
</odoo>
