<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="parcel_transport_category" model="ir.module.category">
            <field name="name">Parcel Transport</field>
            <field name="sequence">20</field>
        </record>

        <record id="parcel_transport_privilege" model="res.groups.privilege">
            <field name="name">Parcel Transport Role</field>
            <field name="category_id" ref="parcel_transport_category"/>
            <field name="sequence">20</field>
        </record>

        <!-- Exactly 4 roles. -->

        <record id="group_parcel_origin_agent" model="res.groups">
            <field name="name">Receiving Officer</field>
            <field name="privilege_id" ref="parcel_transport_privilege"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Creates and receives parcels, assigns them to a Trip, and marks
                them ready for dispatch.</field>
        </record>

        <record id="group_parcel_dispatcher" model="res.groups">
            <field name="name">Dispatcher</field>
            <field name="privilege_id" ref="parcel_transport_privilege"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Creates/manages Trips and dispatches them. The public, login-free
                website "Agent Parcel Arrival" page (parcel number + agent code) is the primary way
                a parcel's arrival and on-collection payment get authorized; the Dispatcher can also
                do both of those from the backend as a fallback/sub-option whenever the field agent
                has not done it on the website yet.</field>
        </record>

        <record id="group_parcel_finance_agent" model="res.groups">
            <field name="name">Finance Manager</field>
            <field name="privilege_id" ref="parcel_transport_privilege"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Oversees and manages payments, and the operational Dashboard.</field>
        </record>

        <record id="group_parcel_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="parcel_transport_privilege"/>
            <field name="sequence">40</field>
            <field name="implied_ids" eval="[(4, ref('group_parcel_origin_agent')),
                                             (4, ref('group_parcel_dispatcher')),
                                             (4, ref('group_parcel_finance_agent'))]"/>
            <field name="comment">Full access to the Parcel Transport application.</field>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
