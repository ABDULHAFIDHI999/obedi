<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_parcel_delivery_authorize_wizard_form" model="ir.ui.view">
        <field name="name">parcel.delivery.authorize.wizard.form</field>
        <field name="model">parcel.delivery.authorize.wizard</field>
        <field name="arch" type="xml">
            <form string="Authorize Delivery">
                <group>
                    <field name="tracking_number"/>
                    <field name="receiver_id"/>
                    <field name="receiver_phone"/>
                    <field name="payment_status" widget="badge"/>
                </group>
                <group>
                    <field name="notes" placeholder="Delivery notes..."/>
                    <field name="proof" widget="image" filename="proof_filename"/>
                    <field name="proof_filename" invisible="1"/>
                </group>
                <footer>
                    <field name="parcel_order_id" invisible="1"/>
                    <button name="action_authorize" string="COMPLETE DELIVERY" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
