<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_parcel_payment_authorize_wizard_form" model="ir.ui.view">
        <field name="name">parcel.payment.authorize.wizard.form</field>
        <field name="model">parcel.payment.authorize.wizard</field>
        <field name="arch" type="xml">
            <form string="Authorize Payment">
                <group>
                    <field name="currency_id" invisible="1"/>
                    <field name="partner_id"/>
                    <field name="amount"/>
                    <field name="payment_method"/>
                    <field name="reference"/>
                </group>
                <field name="notes" placeholder="Notes..."/>
                <footer>
                    <field name="parcel_order_id" invisible="1"/>
                    <button name="action_authorize" string="AUTHORIZE PAYMENT" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
