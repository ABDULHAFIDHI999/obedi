<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_parcel_arrival_authorize_wizard_form" model="ir.ui.view">
        <field name="name">parcel.arrival.authorize.wizard.form</field>
        <field name="model">parcel.arrival.authorize.wizard</field>
        <field name="arch" type="xml">
            <form string="Authorize Arrival">
                <group>
                    <field name="tracking_number"/>
                    <field name="sender_id"/>
                    <field name="receiver_id"/>
                    <field name="destination"/>
                </group>
                <group>
                    <field name="notes" placeholder="Condition of the parcel, discrepancies, etc."/>
                    <field name="proof" widget="image" filename="proof_filename"/>
                    <field name="proof_filename" invisible="1"/>
                </group>
                <footer>
                    <field name="parcel_order_id" invisible="1"/>
                    <button name="action_authorize" string="AUTHORIZE ARRIVAL" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
