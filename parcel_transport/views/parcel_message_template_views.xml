<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_parcel_message_template_list" model="ir.ui.view">
        <field name="name">parcel.message.template.list</field>
        <field name="model">parcel.message.template</field>
        <field name="arch" type="xml">
            <list string="Message Templates" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="sms_type"/>
                <field name="recipient"/>
                <field name="body"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_parcel_message_template_form" model="ir.ui.view">
        <field name="name">parcel.message.template.form</field>
        <field name="model">parcel.message.template</field>
        <field name="arch" type="xml">
            <form string="Message Template">
                <sheet>
                    <group>
                        <field name="sms_type"/>
                        <field name="recipient"/>
                        <field name="active"/>
                    </group>
                    <group string="Message">
                        <field name="body" nolabel="1" placeholder="Available placeholders: {tracking}, {company}, {origin}, {destination}, {url}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_parcel_message_template" model="ir.actions.act_window">
        <field name="name">Message Templates</field>
        <field name="res_model">parcel.message.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No message template yet.</p>
            <p>These are the SMS/WhatsApp messages sent automatically at each parcel checkpoint.
               Edit the wording or who it goes to (sender/receiver) here, at any time.</p>
        </field>
    </record>

</odoo>
