<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kpi_category_view_list" model="ir.ui.view">
        <field name="name">kpi.category.list</field>
        <field name="model">kpi.category</field>
        <field name="arch" type="xml">
            <list string="KPI Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="kpi_count"/>
                <button name="action_view_kpis" type="object" string="KPIs" icon="fa-bar-chart"/>
            </list>
        </field>
    </record>

    <record id="kpi_category_view_form" model="ir.ui.view">
        <field name="name">kpi.category.form</field>
        <field name="model">kpi.category</field>
        <field name="arch" type="xml">
            <form string="KPI Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_kpis" type="object" class="oe_stat_button" icon="fa-bar-chart">
                            <field name="kpi_count" widget="statinfo" string="KPIs"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe this perspective..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kpi_category_view_search" model="ir.ui.view">
        <field name="name">kpi.category.search</field>
        <field name="model">kpi.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_kpi_category" model="ir.actions.act_window">
        <field name="name">KPI Categories</field>
        <field name="res_model">kpi.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
